# Copy this file to .env and fill in real credentials.
# .env is gitignored - never commit real credentials.
#
# One USERNAME/PASSWORD pair per brand, matching the username_env/password_env
# names configured for that brand in config/brands.yaml.

# Demo brand used by the built-in example scraper (tests/fixtures/example_b2b/).
# These are not secret - they're hardcoded in the local test fixture.
EXAMPLE_BRAND_USERNAME=demo_user
EXAMPLE_BRAND_PASSWORD=demo_pass

# Add real brands here as you onboard them, e.g.:
# ACME_BIKES_USERNAME=your_dealer_login
# ACME_BIKES_PASSWORD=your_dealer_password

# Transition Bikes (b2b.transitionbikes.com) - scraper not wired up yet,
# see src/kinetik_stock/scrapers/transition_bikes.py
# TRANSITION_BIKES_USERNAME=your_dealer_login
# TRANSITION_BIKES_PASSWORD=your_dealer_password
